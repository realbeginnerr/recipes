rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'hijmjo@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /taggedProducts/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == productId
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productUrl is string
        && request.resource.data.productUrl.matches('https?://[^ ].+')
        && request.resource.data.thumbnailUrl is string
        && (request.resource.data.thumbnailUrl == '' || request.resource.data.thumbnailUrl.matches('https?://[^ ].+'))
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt is number
        && (!('brandName' in request.resource.data) || request.resource.data.brandName is string)
        && (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price >= 0));
      allow delete: if isAdmin();
    }
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ingredientReports/{reportId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    function publicProduct(data) {
      return data.deleted == false && data.draft == false
        && data.visibility in ['public', 'scheduled']
        && data.publicAfter <= request.time.toMillis();
    }
    function policySafe(policies, complete) {
      return policies.refund.enabled == true
        && policies.refund.defectFee == 0 && policies.exchange.defectFee == 0
        && ((policies.refund.days == null && !complete) || (policies.refund.days is int && policies.refund.days >= 7))
        && ((policies.refund.refundDays == null && !complete) || (policies.refund.refundDays is int && policies.refund.refundDays >= 0 && policies.refund.refundDays <= 3))
        && policies.refund.exceptions.hasOnly(['consumer-damage', 'used', 'perishable', 'custom'])
        && (policies.refund.exceptions.size() == 0 || policies.refund.exceptionNotice == true)
        && (!policies.refund.exceptions.hasAny(['custom']) || policies.refund.customConsent == true);
    }
    function externalProduct(data) {
      return data.get('compositionType', 'single') == 'single'
        && !data.teaTags.hasAny(['혼합차'])
        && data.get('purchaseUrl', '').matches('https?://[^ ].+');
    }
    match /products/{productId} {
      allow read: if isAdmin() || publicProduct(resource.data);
      allow create, update: if isAdmin()
        && !request.resource.data.keys().hasAny(['cost', 'privateData'])
        && request.resource.data.name is string
        && request.resource.data.sku is string
        && request.resource.data.version is int
        && policySafe(request.resource.data.policies, request.resource.data.draft == false && request.resource.data.visibility != 'private' && !externalProduct(request.resource.data));
      allow delete: if isAdmin();
    }
    match /productAdmin/{productId} { allow read, write: if isAdmin(); }
    match /productSkus/{sku} { allow read, write: if isAdmin(); }
    match /productSlugs/{slug} {
      allow read: if isAdmin() || publicProduct(get(/databases/$(database)/documents/products/$(resource.data.productId)).data);
      allow write: if isAdmin();
    }
    match /shopSettings/{id} { allow read: if isAdmin(); allow write: if isAdmin() && policySafe(request.resource.data.policies, true); }
    match /shopPolicyHistory/{id} { allow read: if isAdmin(); allow create: if isAdmin() && policySafe(request.resource.data.policies, true); }
    match /shopPolicies/{id} { allow read: if true; allow write: if isAdmin() && policySafe(request.resource.data.policies, true); }
  }
}
